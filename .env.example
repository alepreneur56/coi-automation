# COI Automation — local runtime secrets
# Copy this file to .env and fill in the values. NEVER commit .env.

# --- Azure app registration (portal.azure.com -> Entra ID -> App registrations) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Anthropic (the coi-automation-claude-code key in 1Password) ---
ANTHROPIC_API_KEY=

# --- Mailbox ---
COI_MAILBOX=admin@clientpolicyhelp.com

# --- Routing / safety ---
# Keep true until end-to-end testing passes. true = all client emails
# redirect to TEST_REDIRECT_TO and CCs are stripped.
TEST_MODE=true
TEST_REDIRECT_TO=alepreneur56@gmail.com
PRODUCER_CC_EMAIL=alepreneur56@gmail.com
REVIEW_RECIPIENT_EMAIL=alepreneur56@gmail.com

# --- Runtime ---
POLL_INTERVAL_SECONDS=60
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- ZIP lookup (see ziplookup.py) ---
# When true, a "missing ZIP" incomplete-request reply gets a best-effort
# ZIP lookup (Zippopotam.us, free/no-key) before asking the client. Only
# auto-fills when city+state maps to exactly one ZIP code; otherwise
# behavior is unchanged. Never blocks/crashes the pipeline on failure.
ZIP_LOOKUP=false

# --- Ops: daily digest, error alerts, retention (all optional) ---
# Daily digest of yesterday's activity, emailed once per day after
# DIGEST_HOUR (local time, 24h clock).
DIGEST_ENABLED=true
DIGEST_HOUR=8
DIGEST_TO=alepreneur56@gmail.com
# Immediate error alerts (at most 1 alert email per 30 minutes)
ALERT_TO=alepreneur56@gmail.com
# Files older than this are deleted by the once-a-day rotation
LOG_RETENTION_DAYS=60
PDF_RETENTION_DAYS=180
# $-per-million-token rates for the digest cost estimate. ALL THREE must be
# set for the cost line to appear; leave blank to omit it. Look up current
# rates for your model on the Anthropic pricing page (cache-write tokens are
# counted at the plain input rate in the estimate).
COST_INPUT_PER_MTOK=
COST_CACHED_INPUT_PER_MTOK=
COST_OUTPUT_PER_MTOK=
