# COI Automation — local runtime secrets
# Copy this file to .env and fill in the values. NEVER commit .env.

# --- Azure app registration (portal.azure.com -> Entra ID -> App registrations) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Anthropic (the coi-automation-claude-code key in 1Password) ---
ANTHROPIC_API_KEY=

# --- Mailbox ---
COI_MAILBOX=admin@clientpolicyhelp.com

# --- Routing / safety ---
# Keep true until end-to-end testing passes. true = all client emails
# redirect to TEST_REDIRECT_TO and CCs are stripped.
TEST_MODE=true
TEST_REDIRECT_TO=alepreneur56@gmail.com
PRODUCER_CC_EMAIL=alepreneur56@gmail.com
REVIEW_RECIPIENT_EMAIL=alepreneur56@gmail.com

# --- Runtime ---
POLL_INTERVAL_SECONDS=60
ANTHROPIC_MODEL=claude-sonnet-4-5
